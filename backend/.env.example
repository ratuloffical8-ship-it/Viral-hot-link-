# ============================================
# Server
# ============================================
PORT=5000
NODE_ENV=production

# Your public site URL (no trailing slash).
# On Render this is your service URL, e.g. https://yourapp.onrender.com
APP_BASE_URL=https://yourapp.onrender.com

# ============================================
# Telegram Mini App auth
# ============================================
# Token from @BotFather
BOT_TOKEN=123456789:ABCDEF_your_bot_token_here

# Two admin Telegram numeric IDs, comma separated (get yours from @userinfobot)
ADMIN_TELEGRAM_IDS=111111111,222222222

# ============================================
# Firebase Realtime Database
# ============================================
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Use ONE of the two options below.
# Option A (recommended on Render): base64 of the whole service-account JSON file
#   Linux/Mac: base64 -w 0 serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Option B: the service-account JSON pasted as a single line
FIREBASE_SERVICE_ACCOUNT=

# ============================================
# ImgBB (link preview images)
# ============================================
IMGBB_API_KEY=your_imgbb_api_key

# ============================================
# GitHub background images (public repo)
# Files must be named 1.jpg ... 10.jpg inside the images path
# Final URL: https://raw.githubusercontent.com/USER/REPO/BRANCH/PATH/1.jpg
# ============================================
GITHUB_USER=your-github-username
GITHUB_REPO=your-images-repo
GITHUB_BRANCH=main
GITHUB_IMAGES_PATH=images
BACKGROUND_IMAGE_COUNT=10
BACKGROUND_IMAGE_EXT=jpg

# ============================================
# Monetag defaults (can be overridden from Dashboard > Monetag Settings)
# ============================================
MONETAG_DOMAIN=3nbf4.com
MONETAG_ZONE_ID=11984257
MONETAG_META_CONTENT=c5d47a0233493b07fc81743d5b51c253
MONETAG_DIRECT_LINK=https://uplcm.com/4/11984259

# ============================================
# Keep-Alive (Render free tier)
# ============================================
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_INTERVAL_MINUTES=3
